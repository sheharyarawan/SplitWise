<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray"
    tools:context=".ui.fragments.groupFragment.DetailGroupFragment">
    <FrameLayout
        android:id="@+id/frameLayout"
        android:layout_width="0dp"
        android:layout_height="200dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#131A49"
            android:contentDescription="@string/background"
            android:scaleType="centerCrop" />
        <ImageView
            android:id="@+id/groupDetailBackBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_margin="15dp"
            android:background="@drawable/detail_group_bg"
            android:contentDescription="@string/back_button"
            android:padding="5dp"
            android:src="@drawable/ic_back" />
        <ImageView
            android:id="@+id/detailGroupSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_margin="15dp"
            android:background="@drawable/detail_group_bg"
            android:contentDescription="@string/settings"
            android:padding="5dp"
            android:src="@drawable/settings_24dp_e3e3e3_fill0_wght400_grad0_opsz24" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="10dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/detailGroupName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_medium"
                android:maxLines="2"
                android:text=""
                android:textColor="@color/white"
                android:textSize="30sp" />
            <com.google.android.material.chip.Chip
                android:id="@+id/detailGroupPeopleCountChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:backgroundTint="@color/gray"
                android:fontFamily="@font/poppins_medium"
                android:text=""
                android:textColor="@color/white"
                android:visibility="gone"
                app:chipCornerRadius="20dp"
                app:chipEndPadding="10dp"
                app:chipStartPadding="10dp"
                app:chipStrokeColor="#656565"
                app:chipStrokeWidth="2dp" />
        </LinearLayout>
    </FrameLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/detailGroupNestedScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/frameLayout">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <LinearLayout
                android:id="@+id/detailGroupExpenseTotalLL"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:padding="10dp">
                <TextView
                    android:id="@+id/detailGroupExpenseTotalTv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:text=""
                    android:textColor="@color/white"
                    android:textSize="19sp" />
            </LinearLayout>
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/detailFriendChipsGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp">
                <com.google.android.material.chip.Chip
                    android:id="@+id/friendDetailSettleUpChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/gray"
                    android:fontFamily="@font/poppins_medium"
                    android:padding="10dp"
                    android:text="@string/settle_up"
                    android:textColor="@color/white"
                    android:textSize="21sp"
                    app:chipCornerRadius="30dp"
                    app:chipEndPadding="8dp"
                    app:chipStartPadding="8dp"
                    app:chipStrokeColor="#363636"
                    app:chipStrokeWidth="2dp" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/balanceChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/gray"
                    android:fontFamily="@font/poppins_medium"
                    android:padding="10dp"
                    android:text="@string/balances"
                    android:textColor="@color/white"
                    android:textSize="21sp"
                    app:chipCornerRadius="30dp"
                    app:chipEndPadding="8dp"
                    app:chipStartPadding="8dp"
                    app:chipStrokeColor="#363636"
                    app:chipStrokeWidth="2dp" />
            </com.google.android.material.chip.ChipGroup>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/detailCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="15dp"
                android:visibility="visible">
                <LinearLayout
                    android:id="@+id/AddGroupMemberLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/light_gray"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_medium"
                        android:gravity="center"
                        android:text="@string/you_re_the_only_one_here"
                        android:textColor="@color/white"
                        android:textSize="18sp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/addFriendGroupButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="5dp"
                        android:backgroundTint="@color/green"
                        android:paddingStart="30dp"
                        android:paddingEnd="30dp"
                        android:text="@string/add_group_members"
                        android:textSize="20sp"
                        app:icon="@drawable/ic_friend"
                        app:iconSize="25dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <LinearLayout
                android:id="@+id/singleMemberLinearDisplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:gravity="center"
                    android:text="@string/no_expense_here_yet"
                    android:textColor="@color/white"
                    android:textSize="22sp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="40dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="40dp"
                    android:fontFamily="@font/poppins_medium"
                    android:text="@string/add_an_expense_to_get_this_party_started"
                    android:textAlignment="center"
                    android:textColor="@color/white"
                    android:textSize="22sp" />
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/detailGroupPaymentsRv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                tools:itemCount="4"
                tools:listitem="@layout/item_view_expense_detail_group" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <ProgressBar
        android:id="@+id/detailGroupProgressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>