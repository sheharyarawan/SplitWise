<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/nonGroupExpensesCL"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintHorizontal_bias="1.0"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@+id/groupsFragmentDrawerTv"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/gray"
    android:layout_marginTop="10dp"
    >

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/groupNonExpenseIv"
        android:layout_width="100dp"
        android:layout_height="100dp"

        android:scaleType="centerCrop"
        android:src="@drawable/groupshomeimage"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium">

    </com.google.android.material.imageview.ShapeableImageView>

    <TextView
        android:id="@+id/groupName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:fontFamily="@font/poppins_medium"
        android:text="group Name"
        android:textColor="@color/white"
        android:textSize="20sp"
        app:layout_constraintBottom_toTopOf="@+id/groupExpenses"
        app:layout_constraintStart_toEndOf="@+id/groupNonExpenseIv"
        app:layout_constraintTop_toTopOf="@+id/groupNonExpenseIv"
        app:layout_constraintVertical_chainStyle="packed">

    </TextView>

    <TextView
        android:id="@+id/groupExpenses"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:text="no expense"
        android:textColor="#C2C0C0"
        android:textSize="19sp"
        app:layout_constraintBottom_toBottomOf="@+id/groupNonExpenseIv"
        app:layout_constraintStart_toEndOf="@+id/groupNonExpenseIv"
        app:layout_constraintTop_toBottomOf="@+id/groupName">
    </TextView>
</androidx.constraintlayout.widget.ConstraintLayout>