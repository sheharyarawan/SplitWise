<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragments.groupFragment.GroupSettingsFragment"
    android:background="@color/gray"
    android:orientation="vertical">


    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarGroupSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationIcon="@drawable/ic_back"
        app:title="Group Settings"
        app:titleTextColor="@color/white"
        app:titleMarginStart="10dp">
    </com.google.android.material.appbar.MaterialToolbar>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/customizeGroupCL"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <ImageView
            android:id="@+id/imageView2"
            android:layout_width="70dp"
            android:layout_height="70dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:src="@drawable/groupshomeimage"
            android:scaleType="centerCrop">

        </ImageView>

        <TextView
            android:id="@+id/groupName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Group"
            android:textColor="@color/white"
            android:textSize="20sp"
            app:layout_constraintBottom_toTopOf="@+id/groupType"
            app:layout_constraintStart_toEndOf="@+id/imageView2"
            app:layout_constraintTop_toTopOf="@+id/imageView2"
            app:layout_constraintVertical_chainStyle="packed">

        </TextView>

        <TextView
            android:id="@+id/groupType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Other"
            android:textSize="18sp"
            android:textColor="#8D8D8D"
            android:layout_marginStart="10dp"
            app:layout_constraintBottom_toBottomOf="@+id/imageView2"
            app:layout_constraintStart_toEndOf="@+id/imageView2"
            app:layout_constraintTop_toBottomOf="@+id/groupName">

        </TextView>

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_edit"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

        </ImageView>


    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#8D8D8D"
        android:layout_marginBottom="10dp">
    </View>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Group members"
        android:textSize="19sp"
        android:layout_marginStart="20dp"
        android:textColor="@color/white">

    </TextView>

    <TextView
        android:id="@+id/addPeopleToGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:text="Add people to group"
        android:textSize="24sp"
        android:textColor="@color/white"
        android:drawableStart="@drawable/ic_addgroup"
        android:drawablePadding="30dp">

    </TextView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/detailGroupSettingsRv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp">

    </androidx.recyclerview.widget.RecyclerView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Advanced settings"
        android:textColor="@color/white"
        android:fontFamily="@font/poppins_medium"
        android:textSize="20sp"
        android:layout_margin="20dp">

    </TextView>

    <TextView
        android:id="@+id/groupDetailSettingsLeaveGroupTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Leave group"
        android:fontFamily="@font/poppins_medium"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:layout_marginStart="20dp"
        android:drawableStart="@drawable/ic_leave_group"
        android:drawablePadding="20dp">
    </TextView>

    <TextView
        android:id="@+id/groupDetailSettingsDeleteGroupTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Delete group"
        android:fontFamily="@font/poppins_medium"
        android:textColor="@color/red"
        android:textSize="22sp"
        android:layout_marginStart="20dp"
        android:drawableTint="@color/red"
        android:drawableStart="@drawable/ic_delete"
        android:drawablePadding="20dp">
    </TextView>
</LinearLayout>