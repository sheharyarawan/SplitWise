<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray"
    android:padding="16dp"
    tools:context=".fragments.groupFragment.GroupsFragment">

    ```
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/groupsToolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:menu="@menu/group_toolbar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/groupsScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/groupsToolbar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/groupsFragmentDrawerTv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:text="You are all settled up!"
                android:textColor="@color/white"
                android:textSize="22sp"
                app:drawableEndCompat="@drawable/ic_drawer"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/groupRv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/groupsFragmentDrawerTv"
                tools:itemCount="2"
                tools:listitem="@layout/item_view_groups" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/nonGroupExpensesCL"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/groupRv">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/groupNonExpenseIv"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:paddingTop="10dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/groupshomeimage"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />

                <TextView
                    android:id="@+id/groupName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:fontFamily="@font/poppins_medium"
                    android:text="Non-group expenses"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    app:layout_constraintBottom_toTopOf="@id/groupExpenses"
                    app:layout_constraintStart_toEndOf="@id/groupNonExpenseIv"
                    app:layout_constraintTop_toTopOf="@id/groupNonExpenseIv"
                    app:layout_constraintVertical_chainStyle="packed" />

                <TextView
                    android:id="@+id/groupExpenses"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:text="settled up"
                    android:textColor="#C2C0C0"
                    android:textSize="19sp"
                    app:layout_constraintBottom_toBottomOf="@id/groupNonExpenseIv"
                    app:layout_constraintStart_toEndOf="@id/groupNonExpenseIv"
                    app:layout_constraintTop_toBottomOf="@id/groupName" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/startAGroupBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:fontFamily="@font/poppins_medium"
                android:padding="15dp"
                android:text="Start a new group"
                android:textColor="@color/green"
                android:textSize="18sp"
                app:backgroundTint="@color/gray"
                app:cornerRadius="30dp"
                app:icon="@drawable/ic_addgroup"
                app:iconSize="30dp"
                app:iconTint="@color/green"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/nonGroupExpensesCL"
                app:strokeColor="@color/green"
                app:strokeWidth="2dp" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/addExpenseBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add expense"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:icon="@drawable/ic_add_expense"
        android:backgroundTint="@color/green"
        android:textSize="20sp"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        app:iconSize="30dp"
        android:fontFamily="@font/poppins_medium">

    </com.google.android.material.button.MaterialButton>

</androidx.constraintlayout.widget.ConstraintLayout>
