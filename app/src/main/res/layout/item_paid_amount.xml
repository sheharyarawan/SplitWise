<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/gray"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="16dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/shapeableImageView3"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:background="@color/white"
        android:src="@drawable/ic_mail"
        android:tint="@color/black"
        android:padding="12dp"
        android:contentDescription="@null"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

    <TextView
        android:id="@+id/whoPaidName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="8dp"
        android:fontFamily="@font/poppins_medium"
        android:text=""
        android:textColor="@color/white"
        android:textSize="22sp"
        android:maxLines="2"
        android:ellipsize="end"
        app:layout_constraintStart_toEndOf="@id/shapeableImageView3"
        app:layout_constraintEnd_toStartOf="@id/textView21"
        app:layout_constraintTop_toTopOf="@id/shapeableImageView3"
        app:layout_constraintBottom_toBottomOf="@id/shapeableImageView3"
        tools:ignore="VisualLintSystemUi" />

    <TextView
        android:id="@+id/textView21"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:text="@string/rs"
        android:textColor="@color/white"
        android:textSize="18sp"
        app:layout_constraintStart_toEndOf="@id/whoPaidName"
        app:layout_constraintEnd_toStartOf="@id/enterPaidAmounteditText"
        app:layout_constraintTop_toTopOf="@id/whoPaidName"
        app:layout_constraintBottom_toBottomOf="@id/whoPaidName" />

    <EditText
        android:id="@+id/enterPaidAmounteditText"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:autofillHints=""
        android:gravity="end"
        android:inputType="numberDecimal"
        android:maxLines="1"
        android:minHeight="48dp"
        android:singleLine="true"
        android:textColor="@color/white"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="@id/whoPaidName"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/textView21"
        app:layout_constraintTop_toTopOf="@id/whoPaidName"
        tools:ignore="LabelFor,SpeakableTextPresentCheck,VisualLintSystemUi" />

</androidx.constraintlayout.widget.ConstraintLayout>